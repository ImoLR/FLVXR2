[Unit]
Description=LeiKwan phone 主备线 backup: GZ:19047 (any source) -> ixp1 163.53.52.189:35046 -> 99U:10017 (nft DNAT, TCP only)
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/leikwan-phone-backup.nft
ExecStop=/usr/sbin/nft delete table ip leikwan_phone_backup

[Install]
WantedBy=multi-user.target
