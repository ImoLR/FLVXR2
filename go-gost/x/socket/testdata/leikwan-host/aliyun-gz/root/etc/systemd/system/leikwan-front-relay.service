[Unit]
Description=LeiKwan TCP front relay
After=network.target leikwan-fast-failover.service
Wants=leikwan-fast-failover.service

[Service]
Type=notify
Environment=GOMAXPROCS=2
ExecStart=/usr/local/bin/leikwan-front-relay
ExecStopPost=/usr/local/bin/leikwan-front-relay --cleanup
WatchdogSec=5
WatchdogSignal=SIGKILL
LimitCORE=0
TimeoutStopSec=3
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
